datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  COURSE_ADMIN
  INSTRUCTOR
  STUDENT
  AUDITOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AuthProvider {
  LOCAL
  LDAP
  AZURE_AD
  GOOGLE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VideoType {
  YOUTUBE
  VIMEO
  INTERNAL_HLS
  INTERNAL_MP4
}

enum EnrollmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  MCQ
  ESSAY
  MATCHING
  DRAG_DROP
}

enum GradingStatus {
  PENDING
  GRADED
}

enum RetentionAction {
  DELETE
  ARCHIVE
}

// ─────────────────────────────────────────────────────────────
// SYSTEM TABLES (no orgId)
// ─────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orgUnits    OrgUnit[]
  users       User[]
  courses     Course[]
  enrollments Enrollment[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ─────────────────────────────────────────────────────────────
// ORGANIZATION STRUCTURE
// ─────────────────────────────────────────────────────────────

model OrgUnit {
  id        String   @id @default(cuid())
  nameTh    String
  nameEn    String
  level     Int      @default(1)
  sortOrder Int      @default(0)

  // Self-referencing hierarchy
  parentId String?
  parent   OrgUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitHierarchy")

  // Multi-tenant
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  // Relations
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([parentId])
  @@map("org_units")
}

// ─────────────────────────────────────────────────────────────
// USER MANAGEMENT
// ─────────────────────────────────────────────────────────────

model User {
  id          String       @id @default(cuid())
  email       String
  password    String?
  firstName   String
  lastName    String
  firstNameTh String?
  lastNameTh  String?
  role        Role         @default(STUDENT)
  status      UserStatus   @default(ACTIVE)
  authProvider AuthProvider @default(LOCAL)
  avatarUrl   String?
  lastLoginAt DateTime?

  // Org structure
  orgUnitId String?
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id])

  // Multi-tenant
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  coursesCreated     Course[]          @relation("CourseCreator")
  courseInstructors  CourseInstructor[]
  enrollments        Enrollment[]
  quizAttempts       QuizAttempt[]
  answersGraded      QuizAnswer[]      @relation("AnswerGrader")
  certificates       Certificate[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  adRoleMappings     AdRoleMapping[]

  @@unique([email, orgId])
  @@index([orgId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model AdRoleMapping {
  id          String @id @default(cuid())
  adGroupName String
  role        Role
  description String?

  // Link to user who created/manages this
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Multi-tenant
  orgId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adGroupName, orgId])
  @@index([orgId])
  @@map("ad_role_mappings")
}

// ─────────────────────────────────────────────────────────────
// COURSE STRUCTURE
// ─────────────────────────────────────────────────────────────

model Course {
  id            String       @id @default(cuid())
  titleTh       String
  titleEn       String
  descriptionTh String?      @db.Text
  descriptionEn String?      @db.Text
  category      String?
  status        CourseStatus @default(DRAFT)
  selfEnroll    Boolean      @default(false)
  thumbnailUrl  String?

  // Creator
  createdById String
  createdBy   User   @relation("CourseCreator", fields: [createdById], references: [id])

  // Multi-tenant
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  instructors  CourseInstructor[]
  modules      Module[]
  enrollments  Enrollment[]
  quizzes      Quiz[]
  certificates Certificate[]

  @@index([orgId])
  @@index([status])
  @@index([category])
  @@map("courses")
}

model CourseInstructor {
  id          String @id @default(cuid())
  permissions Json   @default("{}")

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Multi-tenant
  orgId String

  assignedAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("course_instructors")
}

model Module {
  id        String @id @default(cuid())
  titleTh   String
  titleEn   String
  sortOrder Int    @default(0)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Multi-tenant
  orgId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lessons Lesson[]

  @@index([orgId])
  @@index([courseId])
  @@map("modules")
}

model Lesson {
  id              String     @id @default(cuid())
  titleTh         String
  titleEn         String
  contentTh       String?    @db.Text
  contentEn       String?    @db.Text
  videoUrl        String?
  videoType       VideoType?
  fileUrl         String?
  sortOrder       Int        @default(0)
  durationMinutes Int?

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // Multi-tenant
  orgId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lessonProgress LessonProgress[]

  @@index([orgId])
  @@index([moduleId])
  @@map("lessons")
}

// ─────────────────────────────────────────────────────────────
// ENROLLMENT & PROGRESS
// ─────────────────────────────────────────────────────────────

model Enrollment {
  id          String           @id @default(cuid())
  status      EnrollmentStatus @default(NOT_STARTED)
  progressPct Float            @default(0)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Multi-tenant
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  // Relations
  lessonProgress LessonProgress[]
  certificates   Certificate[]

  @@unique([userId, courseId, orgId])
  @@index([orgId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model LessonProgress {
  id               String    @id @default(cuid())
  completed        Boolean   @default(false)
  completedAt      DateTime?
  timeSpentSeconds Int       @default(0)

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  // Multi-tenant
  orgId String

  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, lessonId])
  @@index([orgId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ─────────────────────────────────────────────────────────────
// QUIZ ENGINE
// ─────────────────────────────────────────────────────────────

model Quiz {
  id                  String  @id @default(cuid())
  titleTh             String
  titleEn             String
  passingScore        Float   @default(80)
  timeLimit           Int?
  maxAttempts         Int     @default(3)
  randomizeQuestions  Boolean @default(false)
  showResultsAfter    Boolean @default(true)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Multi-tenant
  orgId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  questions Question[]
  attempts  QuizAttempt[]

  @@index([orgId])
  @@index([courseId])
  @@map("quizzes")
}

model Question {
  id         String       @id @default(cuid())
  type       QuestionType
  questionTh String       @db.Text
  questionEn String       @db.Text
  config     Json
  points     Float        @default(1)
  sortOrder  Int          @default(0)

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  answers QuizAnswer[]

  @@index([quizId])
  @@map("questions")
}

model QuizAttempt {
  id          String    @id @default(cuid())
  score       Float?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Multi-tenant
  orgId String

  // Relations
  answers QuizAnswer[]

  @@index([orgId])
  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id            String        @id @default(cuid())
  answer        Json
  score         Float?
  gradingStatus GradingStatus @default(PENDING)
  feedback      String?       @db.Text
  gradedAt      DateTime?

  attemptId String
  attempt   QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  gradedById String?
  gradedBy   User?   @relation("AnswerGrader", fields: [gradedById], references: [id])

  @@index([attemptId])
  @@index([questionId])
  @@index([gradingStatus])
  @@map("quiz_answers")
}

// ─────────────────────────────────────────────────────────────
// CERTIFICATES
// ─────────────────────────────────────────────────────────────

model Certificate {
  id            String   @id @default(cuid())
  certificateNo String   @unique
  pdfUrl        String?
  issuedAt      DateTime @default(now())

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  // Multi-tenant
  orgId String

  @@index([orgId])
  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

// ─────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model Notification {
  id      String   @id @default(cuid())
  titleTh String
  titleEn String
  bodyTh  String   @db.Text
  bodyEn  String   @db.Text
  type    String
  read    Boolean  @default(false)
  readAt  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Multi-tenant
  orgId String

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────
// AUDIT LOG (immutable)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String  @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Multi-tenant
  orgId String
  org   Organization @relation(fields: [orgId], references: [id])

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────
// DATA RETENTION
// ─────────────────────────────────────────────────────────────

model RetentionPolicy {
  id            String          @id @default(cuid())
  entityType    String          @unique
  retentionDays Int             @default(365)
  action        RetentionAction @default(ARCHIVE)

  // Multi-tenant
  orgId String

  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("retention_policies")
}
