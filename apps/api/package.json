  },
  "dependencies": {
    "@lms/shared": "workspace:*",
    "@prisma/client": "^6.3.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "cookie": "^1.0.2",
    "hono": "^4.7.0",
    "@hono/node-server": "^1.14.0",
    "ioredis": "^5.4.2",
    "jose": "^6.0.0",
    "ldapjs": "^3.0.7",
    "minio": "^8.0.0",
    "nodemailer": "^6.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie": "^1.0.0",
    "@types/ldapjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "prisma": "^6.3.0",
    "tsc-alias": "^1.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
