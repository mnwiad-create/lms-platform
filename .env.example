# ============================================================
# LMS Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://lms_user:lms_password@localhost:5432/lms_db?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
JWT_SECRET=change-me-to-a-64-char-random-string-in-production-1234567890ab
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Video Server ---
VIDEO_SIGNING_SECRET=shared-secret-with-video-server-team
VIDEO_BASE_URL=https://video.company.local

# --- LDAP / Active Directory ---
LDAP_URL=ldaps://ad.corp.local:636
LDAP_BASE_DN=dc=corp,dc=local
LDAP_BIND_DN=cn=lms-svc,ou=ServiceAccounts,dc=corp,dc=local
LDAP_BIND_PASSWORD=change-me

# --- Azure AD (OIDC) ---
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:3001/api/v1/auth/azure/callback

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# --- MinIO (S3-compatible) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lms-files
MINIO_USE_SSL=false

# --- Email (SMTP) ---
SMTP_HOST=smtp.company.local
SMTP_PORT=587
SMTP_USER=lms@company.local
SMTP_PASSWORD=change-me
SMTP_FROM=LMS System <lms@company.local>

# --- App ---
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
NODE_ENV=development

# --- Multi-tenant ---
DEFAULT_ORG_ID=org-default
DEFAULT_ORG_NAME=My Organization
